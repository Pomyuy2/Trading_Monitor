// SQLite storage for the watchlist, alerts and cached AI outputs.
// The database file lives in server/data/ (git-ignored).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:../data/trading.db"
}

model WatchlistItem {
  id       String   @id @default(cuid())
  userId   String   @default("default-user")
  symbol   String
  addedAt  DateTime @default(now())
  position Int      @default(0) // "My order" (drag to reorder)
  group    String? // optional group name, e.g. "Tech"

  user     User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, symbol])
  @@index([userId])
}

/// kind: price_above | price_below | near_level | breakout
model Alert {
  id           String    @id @default(cuid())
  userId       String    @default("default-user")
  symbol       String
  kind         String
  targetPrice  Float? // price alerts
  levelKind    String? // level alerts: support | resistance
  levelPrice   Float?
  zoneLow      Float?
  zoneHigh     Float?
  levelRange   String? // chart range the level came from (1D, 1Y, ...)
  resolution   String? // candle size used for breakout closes
  armed        Boolean   @default(true) // near_level: armed once price is outside the 1% band
  status       String    @default("active") // active | triggered
  createdAt    DateTime  @default(now())
  triggeredAt  DateTime?
  triggerPrice Float?
  seen         Boolean   @default(false) // user has been shown the trigger

  user         User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([symbol, status])
}

/// Cached AI outputs (news summaries, sentiment tags, guidance) so they survive restarts.
model AiCache {
  key       String   @id
  value     String
  storedAt  DateTime @default(now())
  expiresAt DateTime

  @@index([expiresAt])
}

model Setting {
  key   String @id
  value String
}

/// Web Push subscriptions (installed app / browser) for alert notifications.
model PushSubscription {
  endpoint  String   @id
  userId    String?
  p256dh    String
  auth      String
  lang      String   @default("en")
  createdAt DateTime @default(now())

  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model User {
  id                String             @id @default(cuid())
  email             String
  emailHash         String?            @unique
  name              String?
  passwordHash      String
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  watchlist         WatchlistItem[]
  alerts            Alert[]
  pushSubscriptions PushSubscription[]
}

/// Rate limiting for invalid invite codes during sign-up (max 5 attempts in 5 hours).
model InviteAttempt {
  id        String   @id @default(cuid())
  ip        String
  createdAt DateTime @default(now())

  @@index([ip, createdAt])
}
