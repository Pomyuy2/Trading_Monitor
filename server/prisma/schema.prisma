// SQLite storage for the watchlist, alerts and cached AI outputs.
// The database file lives in server/data/ (git-ignored).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:../data/trading.db"
}

model WatchlistItem {
  id       String   @id @default(cuid())
  userId   String   @default("default-user")
  symbol   String
  addedAt  DateTime @default(now())
  position Int      @default(0) // "My order" (drag to reorder)
  group    String? // optional group name, e.g. "Tech"

  user     User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, symbol])
  @@index([userId])
}

/// kind: price_above | price_below | near_level | breakout
model Alert {
  id           String    @id @default(cuid())
  userId       String    @default("default-user")
  symbol       String
  kind         String
  targetPrice  Float? // price alerts
  levelKind    String? // level alerts: support | resistance
  levelPrice   Float?
  zoneLow      Float?
  zoneHigh     Float?
  levelRange   String? // chart range the level came from (1D, 1Y, ...)
  resolution   String? // candle size used for breakout closes
  armed        Boolean   @default(true) // near_level: armed once price is outside the 1% band
  status       String    @default("active") // active | triggered
  createdAt    DateTime  @default(now())
  triggeredAt  DateTime?
  triggerPrice Float?
  seen         Boolean   @default(false) // user has been shown the trigger

  user         User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([symbol, status])
}

/// Cached AI outputs (news summaries, sentiment tags, guidance) so they survive restarts.
model AiCache {
  key       String   @id
  value     String
  storedAt  DateTime @default(now())
  expiresAt DateTime

  @@index([expiresAt])
}

model Setting {
  key   String @id
  value String
}

/// Web Push subscriptions (installed app / browser) for alert notifications.
model PushSubscription {
  endpoint  String   @id
  userId    String?
  p256dh    String
  auth      String
  lang      String   @default("en")
  createdAt DateTime @default(now())

  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model User {
  id                String                 @id @default(cuid())
  email             String
  emailHash         String?                @unique
  name              String?
  passwordHash      String
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  watchlist         WatchlistItem[]
  alerts            Alert[]
  pushSubscriptions PushSubscription[]
  portfolios        Portfolio[]
  investmentProfile UserInvestmentProfile?
  conversations     Conversation[]
}

/// Rate limiting for invalid invite codes during sign-up (max 5 attempts in 5 hours).
model InviteAttempt {
  id        String   @id @default(cuid())
  ip        String
  createdAt DateTime @default(now())

  @@index([ip, createdAt])
}

/// Persistent quota tracking and circuit-breaker ledger for market data providers.
model QuotaLedger {
  id                  String    @id @default(cuid())
  provider            String
  endpoint            String    @default("default")
  usedRequests        Int       @default(0)
  usedCredits         Int       @default(0)
  windowType          String    @default("rolling") // rolling | fixed
  windowStart         DateTime
  windowEnd           DateTime
  lastRateLimitAt     DateTime?
  lastSuccessAt       DateTime?
  circuitBreakerState String    @default("closed") // closed | open
  circuitBreakerUntil DateTime?
  strikes             Int       @default(0)
  updatedAt           DateTime  @updatedAt

  @@unique([provider, endpoint])
  @@index([provider])
}

/// User-scoped Investment Portfolios.
model Portfolio {
  id           String                 @id @default(cuid())
  userId       String                 @default("default-user")
  name         String
  currency     String                 @default("USD")
  description  String?
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  user         User?                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions PortfolioTransaction[]

  @@index([userId])
}

/// Transaction ledger: BUY, SELL, CASH_DEPOSIT, CASH_WITHDRAWAL, DIVIDEND, FEE.
/// Transactions are the source of truth for all position, P&L, and balance calculations.
model PortfolioTransaction {
  id          String    @id @default(cuid())
  portfolioId String
  symbol      String?   // null for cash deposit / withdrawal
  type        String    // BUY | SELL | CASH_DEPOSIT | CASH_WITHDRAWAL | DIVIDEND | FEE
  quantity    Float     @default(0)
  price       Float     @default(0) // execution price per share or transaction cash amount
  fee         Float     @default(0)
  timestamp   DateTime  @default(now())
  notes       String?

  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@index([portfolioId, timestamp])
  @@index([portfolioId, symbol])
}

/// Optional explicit user investment profile for personalized suitability assessments.
model UserInvestmentProfile {
  id             String   @id @default(cuid())
  userId         String   @unique
  horizon        String   @default("medium") // short | medium | long
  riskTolerance  String   @default("moderate") // conservative | moderate | aggressive
  liquidityNeeds String   @default("medium") // low | medium | high
  lossCapacity   String   @default("moderate") // low | moderate | high
  updatedAt      DateTime @updatedAt

  user           User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// User-scoped AI Chat conversations.
model Conversation {
  id          String   @id @default(cuid())
  userId      String   @default("default-user")
  title       String
  contextMode String   @default("global") // global | stock | portfolio
  contextRef  String?  // symbol if stock, portfolioId if portfolio
  messages    String   // JSON stringified ChatMessage[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
}

/// Financial filings ingested from SEC EDGAR (10-K, 10-Q)
model FinancialDocument {
  id              String            @id // e.g. "sec-NVDA-10-K-2026-02-25"
  symbol          String            // e.g. "NVDA"
  cik             String            // e.g. "0001045810"
  companyName     String            // e.g. "NVIDIA CORP"
  form            String            // "10-K" | "10-Q"
  filingDate      DateTime          // SEC filing acceptance date
  filingDateStr   String            // ISO date string: YYYY-MM-DD
  reportDate      DateTime?         // Period end date
  reportDateStr   String?           // ISO date string: YYYY-MM-DD
  accessionNumber String            // e.g. "0001045810-26-000015"
  primaryDoc      String            // e.g. "nvda-20260125.htm"
  sourceUrl       String            // SEC EDGAR URL
  rawTextPath     String?           // Local cached file path
  chunkCount      Int               @default(0)
  createdAt       DateTime          @default(now())

  sections        DocumentSection[]
  chunks          DocumentChunk[]

  @@unique([symbol, form, filingDateStr])
  @@index([symbol, filingDateStr])
  @@index([filingDateStr])
}

/// Logical section of an SEC filing (e.g. Item 1A Risk Factors, Item 7 MD&A)
model DocumentSection {
  id           String            @id // e.g. "sec-NVDA-10-K-2026-02-25-item-1a"
  documentId   String
  sectionCode  String            // e.g. "ITEM_1A", "ITEM_7", "ITEM_8"
  sectionTitle String            // e.g. "Item 1A. Risk Factors"
  orderIndex   Int               @default(0)
  content      String            // Full text of the section
  chunkCount   Int               @default(0)

  document     FinancialDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  chunks       DocumentChunk[]

  @@unique([documentId, sectionCode])
  @@index([documentId])
  @@index([sectionCode])
}

/// Granular searchable chunk of text with stable citation ID
model DocumentChunk {
  id            String            @id // e.g. "SEC-NVDA-10-K-2026-02-25-ITEM_1A-c1"
  documentId    String
  sectionId     String
  symbol        String            // "NVDA"
  form          String            // "10-K"
  filingDate    DateTime          // SEC filing acceptance date
  filingDateStr String            // ISO date string: YYYY-MM-DD
  reportDate    DateTime?         // Period end date
  reportDateStr String?           // ISO date string: YYYY-MM-DD
  sectionCode   String            // "ITEM_1A"
  sectionTitle  String            // "Item 1A. Risk Factors"
  chunkIndex    Int               // Sequential index within section (1, 2, 3...)
  tokenCount    Int               // Estimated token count
  content       String            // Chunk text

  document      FinancialDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  section       DocumentSection   @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@index([sectionId])
  @@index([symbol, filingDateStr])
  @@index([symbol, form, filingDateStr])
  @@index([symbol, sectionCode])
}

/// Durable SEC Ingestion Job tracking across restarts
model IngestionJob {
  id                String    @id @default(cuid())
  symbol            String
  cik               String
  accessionNumber   String?
  form              String?
  status            String    @default("QUEUED") // QUEUED | RUNNING | INDEXING | READY | FAILED | RETRYABLE | UNAVAILABLE
  error             String?
  retryCount        Int       @default(0)
  maxRetries        Int       @default(3)
  documentsIngested Int       @default(0)
  chunksCreated     Int       @default(0)
  userId            String?
  startedAt         DateTime?
  completedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([symbol, status])
  @@index([cik, status])
  @@index([status])
}
