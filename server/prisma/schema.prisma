// SQLite storage for the watchlist, alerts and cached AI outputs.
// The database file lives in server/data/ (git-ignored).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:../data/trading.db"
}

model WatchlistItem {
  id       String   @id @default(cuid())
  userId   String   @default("default-user")
  symbol   String
  addedAt  DateTime @default(now())
  position Int      @default(0) // "My order" (drag to reorder)
  group    String? // optional group name, e.g. "Tech"

  user     User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, symbol])
  @@index([userId])
}

/// kind: price_above | price_below | near_level | breakout
model Alert {
  id           String    @id @default(cuid())
  userId       String    @default("default-user")
  symbol       String
  kind         String
  targetPrice  Float? // price alerts
  levelKind    String? // level alerts: support | resistance
  levelPrice   Float?
  zoneLow      Float?
  zoneHigh     Float?
  levelRange   String? // chart range the level came from (1D, 1Y, ...)
  resolution   String? // candle size used for breakout closes
  armed        Boolean   @default(true) // near_level: armed once price is outside the 1% band
  status       String    @default("active") // active | triggered
  createdAt    DateTime  @default(now())
  triggeredAt  DateTime?
  triggerPrice Float?
  seen         Boolean   @default(false) // user has been shown the trigger

  user         User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([symbol, status])
}

/// Cached AI outputs (news summaries, sentiment tags, guidance) so they survive restarts.
model AiCache {
  key       String   @id
  value     String
  storedAt  DateTime @default(now())
  expiresAt DateTime

  @@index([expiresAt])
}

model Setting {
  key   String @id
  value String
}

/// Web Push subscriptions (installed app / browser) for alert notifications.
model PushSubscription {
  endpoint  String   @id
  userId    String?
  p256dh    String
  auth      String
  lang      String   @default("en")
  createdAt DateTime @default(now())

  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model User {
  id                String                 @id @default(cuid())
  email             String
  emailHash         String?                @unique
  name              String?
  passwordHash      String
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  watchlist         WatchlistItem[]
  alerts            Alert[]
  pushSubscriptions PushSubscription[]
  portfolios        Portfolio[]
  investmentProfile UserInvestmentProfile?
}

/// Rate limiting for invalid invite codes during sign-up (max 5 attempts in 5 hours).
model InviteAttempt {
  id        String   @id @default(cuid())
  ip        String
  createdAt DateTime @default(now())

  @@index([ip, createdAt])
}

/// Persistent quota tracking and circuit-breaker ledger for market data providers.
model QuotaLedger {
  id                  String    @id @default(cuid())
  provider            String
  endpoint            String    @default("default")
  usedRequests        Int       @default(0)
  usedCredits         Int       @default(0)
  windowType          String    @default("rolling") // rolling | fixed
  windowStart         DateTime
  windowEnd           DateTime
  lastRateLimitAt     DateTime?
  lastSuccessAt       DateTime?
  circuitBreakerState String    @default("closed") // closed | open
  circuitBreakerUntil DateTime?
  strikes             Int       @default(0)
  updatedAt           DateTime  @updatedAt

  @@unique([provider, endpoint])
  @@index([provider])
}

/// User-scoped Investment Portfolios.
model Portfolio {
  id           String                 @id @default(cuid())
  userId       String                 @default("default-user")
  name         String
  currency     String                 @default("USD")
  description  String?
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  user         User?                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions PortfolioTransaction[]

  @@index([userId])
}

/// Transaction ledger: BUY, SELL, CASH_DEPOSIT, CASH_WITHDRAWAL, DIVIDEND, FEE.
/// Transactions are the source of truth for all position, P&L, and balance calculations.
model PortfolioTransaction {
  id          String    @id @default(cuid())
  portfolioId String
  symbol      String?   // null for cash deposit / withdrawal
  type        String    // BUY | SELL | CASH_DEPOSIT | CASH_WITHDRAWAL | DIVIDEND | FEE
  quantity    Float     @default(0)
  price       Float     @default(0) // execution price per share or transaction cash amount
  fee         Float     @default(0)
  timestamp   DateTime  @default(now())
  notes       String?

  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@index([portfolioId, timestamp])
  @@index([portfolioId, symbol])
}

/// Optional explicit user investment profile for personalized suitability assessments.
model UserInvestmentProfile {
  id             String   @id @default(cuid())
  userId         String   @unique
  horizon        String   @default("medium") // short | medium | long
  riskTolerance  String   @default("moderate") // conservative | moderate | aggressive
  liquidityNeeds String   @default("medium") // low | medium | high
  lossCapacity   String   @default("moderate") // low | moderate | high
  updatedAt      DateTime @updatedAt

  user           User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
