# Copy to server/.env and fill in. Never commit .env.
# Leave a key empty to fall back to MockProvider for that provider's capabilities.
FINNHUB_API_KEY=
FMP_API_KEY=
# Free key from https://twelvedata.com (intraday candles for 1H/1D/1W/1M)
TWELVEDATA_API_KEY=
ANTHROPIC_API_KEY=

PORT=4000
WEB_ORIGIN=http://localhost:3000

# Rate limit for /api (requests per minute per IP)
RATE_LIMIT_PER_MIN=300

# MockProvider only: simulate market state -> open | closed | delayed
MOCK_MARKET_STATE=open

# SEC EDGAR (free filings used for guidance). SEC asks for a contact, e.g. "Your Name you@example.com"
SEC_USER_AGENT=
