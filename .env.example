# ==============================================================================
# Trading Monitor Environment Configuration
# ==============================================================================
# Copy this file to .env (for Docker Compose) or server/.env (for local dev)
# Leave API keys empty to run in demo mode with MockProvider.

# ------------------------------------------------------------------------------
# Data Provider API Keys (All have free tiers)
# ------------------------------------------------------------------------------
# Finnhub: Quotes, WebSocket live prices, company news, search
# Get free key at: https://finnhub.io
FINNHUB_API_KEY=

# Financial Modeling Prep (FMP): Daily chart history, profile, analyst metrics
# Get free key at: https://financialmodelingprep.com
FMP_API_KEY=

# Twelve Data: Intraday charts (1H, 1D, 1W, 1M)
# Get free key at: https://twelvedata.com
TWELVEDATA_API_KEY=

# ------------------------------------------------------------------------------
# AI Provider Configuration (Optional)
# ------------------------------------------------------------------------------
# Option A: Anthropic Claude (takes precedence if set)
# Get key at: https://console.anthropic.com
ANTHROPIC_API_KEY=

# Option B: OpenAI-compatible endpoint / model router (used when ANTHROPIC_API_KEY is empty)
# Requires all three variables: AI_BASE_URL, AI_API_KEY, AI_MODEL
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# ------------------------------------------------------------------------------
# Server & Network Configuration
# ------------------------------------------------------------------------------
# Internal server port (default: 4000)
PORT=4000
HOST=0.0.0.0

# Allowed web origins for CORS and WebSocket connections (comma-separated)
# In production, include your public domain(s):
# e.g. https://trading.jarengjar.com,http://localhost:3000,http://localhost:3003
WEB_ORIGIN=https://trading.jarengjar.com,http://trading.jarengjar.com,http://localhost:3000,http://localhost:3003,http://127.0.0.1:3000,http://127.0.0.1:3003

# API rate limiting per IP (requests per minute)
RATE_LIMIT_PER_MIN=300

# ------------------------------------------------------------------------------
# Optional Settings
# ------------------------------------------------------------------------------
# Mock market state for demo data: open | closed | delayed
MOCK_MARKET_STATE=open

# SEC EDGAR user agent (e.g. "Your Name you@example.com")
SEC_USER_AGENT=TradingMonitor personal research app

# Web Push contact (VAPID subject), e.g. mailto:you@example.com
VAPID_SUBJECT=mailto:trading-monitor@example.com

# ------------------------------------------------------------------------------
# Auth.js Authentication
# ------------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET=your-random-secret-key-at-least-32-chars
# Public URL for Auth.js redirects and CSRF verification
AUTH_URL=https://trading.jarengjar.com
AUTH_TRUST_HOST=true
# Invitation code for new user signups
AUTH_INVITE_CODE=Y0DlUkMu@Y

